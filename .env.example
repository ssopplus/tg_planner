# База данных
# Прод — Supabase, локально — Postgres в Docker (порт 5433).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/tg_planer"
# Telegram Bot (получить у @BotFather)
BOT_TOKEN=""

# LLM (OpenRouter по умолчанию)
LLM_API_KEY=""
LLM_MODEL="openai/gpt-4o-mini"
LLM_BASE_URL="https://openrouter.ai/api/v1"

# Speech-to-Text (распознавание голоса)
# Порядок провайдеров (через запятую). Доступны: groq, assemblyai, whisper.
# Каждый провайдер активируется, если задан его ключ. Цепочка идёт сверху вниз с fallback.
STT_PROVIDERS="groq,assemblyai,whisper"

# Groq Whisper-large-v3-turbo — основной STT (~0.5с на 30с аудио, ~$0.004/мин)
# Получить ключ: https://console.groq.com/keys
GROQ_API_KEY=""

# AssemblyAI Universal-2 — резервный STT
# Получить ключ: https://www.assemblyai.com/app/api-keys
ASSEMBLYAI_API_KEY=""

# Legacy: OpenAI Whisper API напрямую (deprecated, оставлено для совместимости)
WHISPER_API_KEY=""
WHISPER_BASE_URL="https://api.openai.com/v1"

# Webhook (для dev через ngrok)
WEBHOOK_URL=""

# URL Mini App (для кнопки в боте)
WEBAPP_URL=""

# Vercel Cron Secret
CRON_SECRET=""

# Obsidian-vault git sync. Подробности: docs/obsidian-sync.md
# Webhook secret из настроек GitHub-репо vault'а (Settings → Webhooks)
GITHUB_WEBHOOK_SECRET=""
# PAT с правом repo для read+write-back в vault-репозиторий
GITHUB_VAULT_TOKEN=""
# UUID пользователя из БД, если их несколько (иначе берётся единственный)
OBSIDIAN_SYNC_USER_ID=""

# Yandex Tracker (Этап F, ещё не реализован — но env слот резервирую)
YANDEX_TRACKER_TOKEN=""
YANDEX_TRACKER_ORG_ID=""
