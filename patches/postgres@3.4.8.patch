diff --git a/cf/polyfills.js b/cf/polyfills.js
index 53c5203dd5b057d741d14d708ba83b27751b527c..e4c2a50757dacb60fe61a37230105b90fb9652bf 100644
--- a/cf/polyfills.js
+++ b/cf/polyfills.js
@@ -178,8 +178,19 @@ function Socket() {
     tcp.emit('close')
   }
 
+  // На серверах Cloudflare запись в сокет одним куском от 64 КБ обрывает соединение
+  // (write CONNECTION_CLOSED). Режем на 16 КБ; все куски встают в очередь writer сразу,
+  // поэтому порядок со следующими write не нарушается.
   function write(data, cb) {
-    tcp.writer.write(data).then(cb, error)
+    const CHUNK = 16384
+    if (!data || data.length <= CHUNK) {
+      tcp.writer.write(data).then(cb, error)
+      return true
+    }
+    const parts = []
+    for (let i = 0; i < data.length; i += CHUNK)
+      parts.push(tcp.writer.write(data.subarray(i, i + CHUNK)))
+    Promise.all(parts).then(() => cb && cb(), error)
     return true
   }
 
